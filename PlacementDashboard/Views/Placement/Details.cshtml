@model PlacementDashboard.Models.Placement
@{
    ViewData["Title"] = "Student Details";
}

<h2 class="mb-3">Student Details</h2>

@* DetailsView-style single record display *@
<dl class="row">
    <dt class="col-sm-3">Student ID</dt>
    <dd class="col-sm-9">@Model.Id</dd>

    <dt class="col-sm-3">Name</dt>
    <dd class="col-sm-9">@Model.Name</dd>

    <dt class="col-sm-3">Company</dt>
    <dd class="col-sm-9">@Model.Company</dd>

    <dt class="col-sm-3">Package</dt>
    <dd class="col-sm-9">@Model.PackageLPA LPA</dd>

    <dt class="col-sm-3">Branch</dt>
    <dd class="col-sm-9">@Model.Branch</dd>

    <dt class="col-sm-3">Year</dt>
    <dd class="col-sm-9">@Model.Year</dd>
</dl>

<a asp-action="Index" class="btn btn-secondary">Back to Dashboard</a>
